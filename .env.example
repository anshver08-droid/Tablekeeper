POSTGRES_DB=tablekeeper
POSTGRES_USER=tablekeeper
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Set DATABASE_URL to match the local POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above.
DATABASE_URL=postgres://tablekeeper:replace-with-a-strong-local-password@127.0.0.1:5432/tablekeeper
HOST=127.0.0.1
PORT=3000
BOOKING_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_WINDOW_SECONDS=900
BOOKING_RATE_LIMIT_HMAC_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
# Leave empty to use the direct TCP peer. Otherwise list only proxy IPs/CIDRs you operate, comma-separated.
TRUSTED_PROXY_CIDRS=
